{
  "name": "@vishyfishy2/trace-server",
  "version": "0.1.1",
  "type": "module",
  "description": "Load-once, query-many server for Chrome DevTools performance traces. Built for AI agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/f1shy-dev/agent-devtools-trace.git"
  },
  "keywords": [
    "devtools",
    "trace",
    "chrome",
    "performance",
    "agent",
    "cli",
    "bun"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "trace-server": "./src/cli/index.ts"
  },
  "scripts": {
    "dev:server": "bun run src/server/index.ts",
    "lint": "oxlint",
    "fmt": "oxfmt --write src/",
    "fmt:check": "oxfmt --check src/",
    "typecheck": "npx @typescript/native-preview",
    "test": "vitest",
    "prepublishOnly": "bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "^7.0.0-dev",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "citty": "^0.2.1",
    "typescript": "^5.9.0"
  }
}
